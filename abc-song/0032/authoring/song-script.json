      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r2-Q",
      "sectionId": "r2-q-t",
      "text": "Spot Q ... Quartz! Trace the land or ice shape in the air.",
      "targetId": "Q",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-R",
      "sectionId": "r2-q-t",
      "text": "Remember R ... Rattlesnake! Trace one slow curving path with a finger.",
      "targetId": "R",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-S",
      "sectionId": "r2-q-t",
      "text": "S? ... Scorpion! Wiggle tiny fingers or make a small flutter.",
      "targetId": "S",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-T",
      "sectionId": "r2-q-t",
      "text": "Find T ... Tortoise! Trace one slow curving path with a finger.",
      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Spot U ... Urial! Tap two quiet hoof-beats with your fingers.",
      "targetId": "U",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "Remember V ... Vulture! Lift two gentle wings, then hold still.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "W? ... Wren! Lift two gentle wings, then hold still.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
      "sectionId": "r2-u-x",
      "text": "Find X ... Xerophyte! Grow one hand upward, then sway.",
      "targetId": "X",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Y",
      "sectionId": "r2-y-z",
      "text": "Spot Y ... Yellow Scorpion! Wiggle tiny fingers or make a small flutter.",
      "targetId": "Y",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Z",
      "sectionId": "r2-y-z",
      "text": "Remember Z ... Ziziphus Shrub! Grow one hand upward, then sway.",
      "targetId": "Z",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
