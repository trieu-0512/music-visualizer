      "text": "Show L ... Lynx! Make two quiet paw-steps.",
      "targetId": "L",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-M",
      "sectionId": "r2-m-p",
      "text": "Call M ... Murre! Lift two gentle wings, then hold still.",
      "targetId": "M",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
      "sectionId": "r2-m-p",
      "text": "N ... N ... Narwhal! Point one finger forward like a tusk, then glide.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "Ready for O? ... Owl! Lift two gentle wings, then hold still.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "Show P ... Polar Bear! Make two quiet paw-steps.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
