      "sectionId": "r2-q-t",
      "text": "Spot Q ... Quail! Make tiny pecking finger taps.",
      "targetId": "Q",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-R",
