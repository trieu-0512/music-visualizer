      "text": "Remember N ... Nasturtium! Open both hands like a flower.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "O? ... Orchid! Open both hands like a flower.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "Find P ... Pot! Cup both hands like a plant pot.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
