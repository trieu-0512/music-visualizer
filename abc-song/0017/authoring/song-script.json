    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "Remember V ... Violet! Open both hands like a flower.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "W? ... Watering Can! Mime one gentle pour toward the ground.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
      "sectionId": "r2-u-x",
      "text": "Find X ... Xeranthemum! Open both hands like a flower.",
      "targetId": "X",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Y",
      "sectionId": "r2-y-z",
      "text": "Spot Y ... Yarrow! Open both hands like a flower.",
      "targetId": "Y",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Z",
      "sectionId": "r2-y-z",
      "text": "Remember Z ... Zinnia! Open both hands like a flower.",
      "targetId": "Z",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
