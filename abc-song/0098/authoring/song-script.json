    },
    {
      "id": "outro-1",
      "sectionId": "outro",
      "text": "Last clap lands after the zebra stripes are named.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "outro-2",
      "sectionId": "outro",
      "text": "A to Z closes on a cross-section, not a sugar score.",
