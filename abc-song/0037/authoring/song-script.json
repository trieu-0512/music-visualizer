      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Spot U ... Umiak! Point to the matching picture, then make one small shape gesture.",
      "targetId": "U",
