      "text": "Bakery sort T ... Tart! Shallow shell; open filling.",
      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Dough family U ... Upside-down Cake! Cake top; fruit surface.",
      "targetId": "U",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "Structure V ... Vanilla Cake! Cake slice; crumb and layers.",
      "targetId": "V",
