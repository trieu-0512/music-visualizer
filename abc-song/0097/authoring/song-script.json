      "objectReveal": "target-word"
    },
    {
      "id": "r2-I",
      "sectionId": "r2-i-l",
      "text": "Dough family I ... Ice Cream! Frozen scoop or swirl—no baking.",
      "targetId": "I",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-J",
      "sectionId": "r2-i-l",
      "text": "Structure J ... Jam Tart! Shallow shell; jam center.",
      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "Yeast, crust, or batter—K? ... Kaiser Roll! Round roll; star-like top.",
      "targetId": "K",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-L",
      "sectionId": "r2-i-l",
      "text": "Bakery sort L ... Lemon Tart! Tart shell; lemon filling.",
      "targetId": "L",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-M",
      "sectionId": "r2-m-p",
      "text": "Dough family M ... Muffin! Cup base; rounded top.",
      "targetId": "M",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
      "sectionId": "r2-m-p",
      "text": "Structure N ... Napoleon Pastry! Thin layers; filling lines.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "Yeast, crust, or batter—O? ... Orange Cake! Cake slice; citrus layer or decoration.",
      "targetId": "O",
