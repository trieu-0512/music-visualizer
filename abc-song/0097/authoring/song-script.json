    {
      "id": "intro-1",
      "sectionId": "intro",
      "text": "Bread can rise with yeast; Danish gets lift from yeast and layers; scone is a quick bread; ice cream is not dough at all.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "intro-2",
      "sectionId": "intro",
      "text": "Bakery names belong to different structure families.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r1-A",
      "sectionId": "r1-a-d",
      "text": "A — Apple Pie! Fruit filling enclosed partly or fully by pastry crust | crust family, not yeast bread.",
      "targetId": "A",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-B",
      "sectionId": "r1-a-d",
      "text": "B ... B ... Bread! Flour-water dough develops structure and often rises through yeast fermentation | broad family with many formulas.",
      "targetId": "B",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-C",
      "sectionId": "r1-a-d",
      "text": "C? Cupcake! Small cake made from batter | chemical leavening and/or whipped-air structure depends recipe.",
      "targetId": "C",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-D",
      "sectionId": "r1-a-d",
      "text": "D is Danish. Laminated yeasted dough creates flaky layers | pastry family.",
      "targetId": "D",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-E",
      "sectionId": "r1-e-h",
      "text": "E — Egg Tart! Pastry shell holds baked egg custard | crust plus custard, not bread crumb.",
      "targetId": "E",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-F",
      "sectionId": "r1-e-h",
      "text": "F ... F ... Fruitcake! Dense cake batter carries dried/candied fruit | cake family.",
      "targetId": "F",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-G",
      "sectionId": "r1-e-h",
      "text": "G? Gingerbread! Can be cookie, cake, or loaf depending formula | one name spans different structures.",
      "targetId": "G",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-H",
      "sectionId": "r1-e-h",
      "text": "H is Honey Bun. Soft sweet yeast dough rolled/coiled before baking | yeast family.",
      "targetId": "H",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-2-1",
      "sectionId": "chorus-r1-2",
      "text": "Yeast, layer, batter—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-2-2",
      "sectionId": "chorus-r1-2",
      "text": "Sort the structure before you bounce the rhyme.",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-I",
      "sectionId": "r1-i-l",
      "text": "I — Ice Cream! Frozen aerated dessert/emulsion | deliberate non-dough exception.",
      "targetId": "I",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-J",
      "sectionId": "r1-i-l",
      "text": "J ... J ... Jam Tart! Shallow pastry crust with jam filling | tart-crust family.",
      "targetId": "J",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-K",
      "sectionId": "r1-i-l",
      "text": "K? Kaiser Roll! Individual yeast bread roll with segmented top pattern | bread family.",
      "targetId": "K",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-L",
      "sectionId": "r1-i-l",
      "text": "L is Lemon Tart. Pastry shell plus lemon filling | tart family.",
      "targetId": "L",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-M",
      "sectionId": "r1-m-p",
      "text": "M — Muffin! Quick bread/cake-like batter typically leavened chemically | no long yeast proof required.",
      "targetId": "M",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-N",
      "sectionId": "r1-m-p",
      "text": "N ... N ... Napoleon Pastry! Crisp puff-pastry layers plus filling | lamination/steam creates many sheets.",
      "targetId": "N",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-O",
      "sectionId": "r1-m-p",
      "text": "O? Orange Cake! Cake batter flavored with orange | cake family.",
      "targetId": "O",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-P",
      "sectionId": "r1-m-p",
      "text": "P is Pie. Pastry crust holds a filling | broad crust family.",
      "targetId": "P",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Q",
      "sectionId": "r1-q-t",
      "text": "Q — Quiche! Savory egg custard baked in pastry crust | crust family with savory filling.",
      "targetId": "Q",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-R",
      "sectionId": "r1-q-t",
      "text": "R ... R ... Raisin Bread! Yeast bread with raisins through crumb | bread family.",
      "targetId": "R",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-S",
      "sectionId": "r1-q-t",
      "text": "S? Scone! Quick bread using chemical leavening in typical recipes | different from yeast roll.",
      "targetId": "S",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-T",
      "sectionId": "r1-q-t",
      "text": "T is Tart. Shallow pastry shell with open filling | crust family.",
      "targetId": "T",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-U",
      "sectionId": "r1-u-x",
      "text": "U — Upside-down Cake! Cake batter bakes over fruit/topping and is inverted for serving | cake family.",
      "targetId": "U",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-V",
      "sectionId": "r1-u-x",
      "text": "V ... V ... Vanilla Cake! Vanilla-flavored cake batter/foam structure | cake family.",
      "targetId": "V",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-W",
      "sectionId": "r1-u-x",
      "text": "W? Waffle! Pourable batter sets between hot patterned plates | batter family, not oven loaf.",
      "targetId": "W",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-X",
      "sectionId": "r1-u-x",
      "text": "X is X-shaped Pretzel. Pretzel yeast dough shaped into X | same dough family, different geometry.",
      "targetId": "X",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-6-1",
      "sectionId": "chorus-r1-6",
      "text": "Yeast, layer, batter—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-6-2",
      "sectionId": "chorus-r1-6",
      "text": "Sort the structure before you bounce the rhyme.",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-Y",
      "sectionId": "r1-y-z",
      "text": "Y — Yule Log! Rolled sponge cake with filling | cake/foam family, not actual bread log.",
      "targetId": "Y",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Z",
      "sectionId": "r1-y-z",
      "text": "Z ... Z ... Zucchini Bread! Sweet quick-bread loaf commonly chemically leavened | loaf shape does not make it yeast bread.",
      "targetId": "Z",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r2-A",
      "sectionId": "r2-a-d",
      "text": "Dough family A ... Apple Pie! Round crust; apple filling.",
      "targetId": "A",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-B",
      "sectionId": "r2-a-d",
      "text": "Structure B ... Bread! Loaf crust; inner crumb.",
      "targetId": "B",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-C",
      "sectionId": "r2-a-d",
      "text": "Yeast, crust, or batter—C? ... Cupcake! Wrapper cup; rounded top.",
      "targetId": "C",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-D",
      "sectionId": "r2-a-d",
      "text": "Bakery sort D ... Danish! Flaky folds; filling center.",
      "targetId": "D",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-E",
      "sectionId": "r2-e-h",
      "text": "Dough family E ... Egg Tart! Small shell; smooth custard.",
      "targetId": "E",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-F",
      "sectionId": "r2-e-h",
      "text": "Structure F ... Fruitcake! Cake slice; fruit-specked crumb.",
      "targetId": "F",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-G",
      "sectionId": "r2-e-h",
      "text": "Yeast, crust, or batter—G? ... Gingerbread! Brown crumb; loaf, cake, or cookie outline.",
