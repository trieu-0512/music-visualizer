      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-B",
      "sectionId": "r1-a-d",
      "text": "B lands on Bluebird. Bluebird is a feathered bird; beak and feet hint at how it lives.",
