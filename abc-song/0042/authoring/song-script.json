      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "O? ... Outcrop! Trace the land or ice shape in the air.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
