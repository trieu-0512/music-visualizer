{
  "version": 1,
  "mappingRevision": 1,
  "lines": [
    {
      "id": "intro-1",
      "sectionId": "intro",
      "text": "Empty basket, cool morning, orchard rows ahead.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "intro-2",
      "sectionId": "intro",
      "text": "Rustle, lift, carry—the harvest day begins.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r1-A",
      "sectionId": "r1-a-d",
      "text": "Empty basket, A — Apple! Round fruit twists from the branch | first harvest weight in our hands.",
      "targetId": "A",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-B",
      "sectionId": "r1-a-d",
      "text": "B is Bucket. Handle lifts, open top waits | water or gathered things can travel inside.",
      "targetId": "B",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-C",
      "sectionId": "r1-a-d",
      "text": "C? Chicken! Scratch and peck beside the orchard path | quick feet stir dry earth.",
      "targetId": "C",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-D",
      "sectionId": "r1-a-d",
      "text": "D ... D ... Duck! At the pond, webbed feet paddle | harvest day keeps moving past the water.",
      "targetId": "D",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-E",
      "sectionId": "r1-e-h",
      "text": "Gather clue E — Egg. Smooth oval shell | set carefully, never tossed.",
      "targetId": "E",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-F",
      "sectionId": "r1-e-h",
      "text": "F is Fence. Post after post | it marks where field ends and path begins.",
      "targetId": "F",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-G",
      "sectionId": "r1-e-h",
      "text": "G? Goat! Cloven hooves at the gate | a curious browser reaches for leaves.",
      "targetId": "G",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-H",
      "sectionId": "r1-e-h",
      "text": "H — Hay. Cut, dried, stacked | golden feed saved after the field is cleared.",
      "targetId": "H",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-2-1",
      "sectionId": "chorus-r1-2",
      "text": "Fill the basket—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-2-2",
      "sectionId": "chorus-r1-2",
      "text": "Harvest day grows full by Z!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-I",
      "sectionId": "r1-i-l",
      "text": "Next load, I — Irrigation Pump. Water pushed through hose and pipe helped crops reach harvest.",
      "targetId": "I",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-J",
      "sectionId": "r1-i-l",
      "text": "J ... J ... Jug! Handle, narrow mouth | liquid pours in a steady stream.",
      "targetId": "J",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-K",
      "sectionId": "r1-i-l",
      "text": "K? Kid Goat! Quick hooves circle the busy yard | a young goat curious about every lift and step.",
      "targetId": "K",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-L",
      "sectionId": "r1-i-l",
      "text": "L is Ladder. Rung over rung | adults use it to reach high places; children watch safely.",
      "targetId": "L",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-M",
      "sectionId": "r1-m-p",
      "text": "Midday break, M — Milk. Pale food produced by mammals | common in dairy-farm life.",
      "targetId": "M",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-N",
      "sectionId": "r1-m-p",
      "text": "N ... N ... Nest. Twigs cradle eggs or chicks | a different kind of gathering place.",
      "targetId": "N",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-O",
      "sectionId": "r1-m-p",
      "text": "O? Orchard! Tree after tree | this is where many fruit harvests begin.",
      "targetId": "O",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-P",
      "sectionId": "r1-m-p",
      "text": "P is Pitchfork. Long handle, pointed tines | adult farm tool, seen and named from a safe distance.",
      "targetId": "P",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Q",
      "sectionId": "r1-q-t",
      "text": "Fuller day, Q — Quilt. Stitch after stitch | soft layers come together as one warm blanket.",
      "targetId": "Q",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-R",
      "sectionId": "r1-q-t",
      "text": "R ... R ... Rake! Teeth in a row | adults pull loose plant material into a pile.",
      "targetId": "R",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-S",
      "sectionId": "r1-q-t",
      "text": "S? Sheep! Woolly fleece in the field | grazing while harvest work passes nearby.",
      "targetId": "S",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-T",
      "sectionId": "r1-q-t",
      "text": "T is Tractor. Big wheels carry the work onward | pulling or powering heavy equipment.",
      "targetId": "T",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-5-1",
      "sectionId": "chorus-r1-5",
      "text": "Fill the basket—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-5-2",
      "sectionId": "chorus-r1-5",
      "text": "Harvest day grows full by Z!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-U",
      "sectionId": "r1-u-x",
      "text": "Last loads, U — Utility Cart. Tools and supplies ride together from job to job.",
      "targetId": "U",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-V",
      "sectionId": "r1-u-x",
      "text": "V ... V ... Vegetable Basket! This one really fills | gathered produce settles side by side.",
      "targetId": "V",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-W",
      "sectionId": "r1-u-x",
      "text": "W? Wheat! Tall grain heads hold the seeds | grain later ground to make flour.",
      "targetId": "W",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-X",
      "sectionId": "r1-u-x",
      "text": "X is Xylophone—our porch-side X helper | tuned bars turn the harvest rhythm into notes.",
      "targetId": "X",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Y",
      "sectionId": "r1-y-z",
      "text": "Near the bottom, Y — Yam. Thick underground tuber | harvest comes up from soil, not down from a branch.",
      "targetId": "Y",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Z",
      "sectionId": "r1-y-z",
      "text": "Z ... Z ... Zebu. Shoulder hump above sturdy cattle | one last farm clue as the full basket heads home.",
      "targetId": "Z",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r2-A",
      "sectionId": "r2-a-d",
      "text": "Harvest clue A ... Apple! Pretend to pick it gently, then show the picture.",
      "targetId": "A",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-B",
      "sectionId": "r2-a-d",
      "text": "Spot B ... Bucket! Make a round bucket with both hands.",
      "targetId": "B",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-C",
      "sectionId": "r2-a-d",
      "text": "C? ... Chicken! Lift two gentle wings, then hold still.",
      "targetId": "C",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-D",
      "sectionId": "r2-a-d",
      "text": "Find D ... Duck! Paddle both hands gently.",
      "targetId": "D",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-E",
      "sectionId": "r2-e-h",
      "text": "Harvest clue E ... Egg! Make a small oval with your hands.",
      "targetId": "E",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-F",
      "sectionId": "r2-e-h",
      "text": "Spot F ... Fence! Hold fingers upright like fence posts.",
      "targetId": "F",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-G",
      "sectionId": "r2-e-h",
      "text": "G? ... Goat! Tap two quiet hoof-beats with your fingers.",
      "targetId": "G",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-H",
      "sectionId": "r2-e-h",
      "text": "Find H ... Hay! Spread fingers like a loose bundle of hay.",
      "targetId": "H",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-I",
      "sectionId": "r2-i-l",
      "text": "Harvest clue I ... Irrigation Pump! Point to the picture and name its job.",
      "targetId": "I",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-J",
      "sectionId": "r2-i-l",
      "text": "Spot J ... Jug! Mime one gentle pouring motion.",
      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "K? ... Kid Goat! Tap two quiet hoof-beats with your fingers.",
      "targetId": "K",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-L",
      "sectionId": "r2-i-l",
      "text": "Find L ... Ladder! Point to the matching picture, then make one small shape gesture.",
      "targetId": "L",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "chorus-r2-3-1",
      "sectionId": "chorus-r2-3",
      "text": "Fill the basket—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r2-3-2",
      "sectionId": "chorus-r2-3",
      "text": "Harvest day grows full by Z!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r2-M",
      "sectionId": "r2-m-p",
      "text": "Harvest clue M ... Milk! Point to the matching picture, then make one small shape gesture.",
      "targetId": "M",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
      "sectionId": "r2-m-p",
      "text": "Spot N ... Nest! Cup both hands like a nest.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "O? ... Orchard! Point to the matching picture, then make one small shape gesture.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "Find P ... Pitchfork! Point to the picture and name its job.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Q",
      "sectionId": "r2-q-t",
      "text": "Harvest clue Q ... Quilt! Mime pulling a warm quilt up gently.",
      "targetId": "Q",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-R",
      "sectionId": "r2-q-t",
      "text": "Spot R ... Rake! Point to the picture and name its job.",
      "targetId": "R",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-S",
      "sectionId": "r2-q-t",
      "text": "S? ... Sheep! Tap two quiet hoof-beats with your fingers.",
      "targetId": "S",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-T",
      "sectionId": "r2-q-t",
      "text": "Find T ... Tractor! Roll two fists slowly like big wheels.",
      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Harvest clue U ... Utility Cart! Point to the picture and name its job.",
      "targetId": "U",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "Spot V ... Vegetable Basket! Point to the matching picture, then make one small shape gesture.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "W? ... Wheat! Point to the matching picture, then make one small shape gesture.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
      "sectionId": "r2-u-x",
      "text": "Find X ... Xylophone! Tap two fingers in the air like gentle xylophone mallets.",
      "targetId": "X",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "chorus-r2-6-1",
      "sectionId": "chorus-r2-6",
      "text": "Fill the basket—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r2-6-2",
      "sectionId": "chorus-r2-6",
      "text": "Harvest day grows full by Z!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r2-Y",
      "sectionId": "r2-y-z",
      "text": "Harvest clue Y ... Yam! Pretend to pick it gently, then show the picture.",
      "targetId": "Y",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Z",
      "sectionId": "r2-y-z",
      "text": "Spot Z ... Zebu! Tap two quiet hoof-beats with your fingers.",
      "targetId": "Z",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "outro-1",
      "sectionId": "outro",
      "text": "Basket full; long shadows cross the floor.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "outro-2",
      "sectionId": "outro",
      "text": "We gathered A to Z—and still the fields hold more.",
      "objective": "narration",
      "objectReveal": "none"
    }
  ]
}
