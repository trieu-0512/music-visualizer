  "lines": [
    {
      "id": "intro-1",
      "sectionId": "intro",
      "text": "Shh... a star just blinked our first clue.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "intro-2",
      "sectionId": "intro",
      "text": "Catch the letter, catch the word, then send it into orbit.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r1-A",
      "sectionId": "r1-a-d",
      "text": "Astronaut—that is our A. Astronaut up high | shape, motion, or job tells us why",
      "targetId": "A",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-B",
      "sectionId": "r1-a-d",
      "text": "Spot B: Booster! A rocket booster provides extra thrust during an early part of a launch.",
      "targetId": "B",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-C",
      "sectionId": "r1-a-d",
      "text": "C brings Comet; Comet comes near | icy glow and tail appear",
      "targetId": "C",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-D",
      "sectionId": "r1-a-d",
      "text": "A clue for D: Dwarf Planet. A dwarf planet orbits the Sun and is round, but it has not cleared other objects from its orbital neighborhood.",
      "targetId": "D",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-E",
      "sectionId": "r1-e-h",
      "text": "past the quiet stars, here comes Eclipse for E. Eclipse up high | shape, motion, or job tells us why",
      "targetId": "E",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-F",
      "sectionId": "r1-e-h",
      "text": "Fuel Tank—that is our F. A spacecraft fuel or propellant tank stores material used by an engine or thruster system.",
      "targetId": "F",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-G",
      "sectionId": "r1-e-h",
      "text": "Spot G: Galaxy! A galaxy is a huge system of stars, gas, dust, and dark matter held together by gravity.",
      "targetId": "G",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-H",
      "sectionId": "r1-e-h",
      "text": "H brings Helmet; A space helmet protects an astronaut's head and helps provide a safe breathing environment inside the suit system.",
      "targetId": "H",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-I",
      "sectionId": "r1-i-l",
      "text": "A clue for I: Io. Io up high | shape, motion, or job tells us why",
      "targetId": "I",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-J",
      "sectionId": "r1-i-l",
      "text": "past the quiet stars, here comes Jupiter for J. It is the largest planet in our solar system and has a giant atmosphere with powerful storms.",
      "targetId": "J",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-K",
      "sectionId": "r1-i-l",
      "text": "Kuiper Belt—that is our K. It is a broad region beyond Neptune containing many icy bodies.",
      "targetId": "K",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-L",
      "sectionId": "r1-i-l",
      "text": "Spot L: Lunar Rover! A lunar rover is a vehicle designed to travel across the Moon's surface.",
      "targetId": "L",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-3-1",
      "sectionId": "chorus-r1-3",
      "text": "Star by star, A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-3-2",
      "sectionId": "chorus-r1-3",
      "text": "Catch the word and orbit with me!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-M",
      "sectionId": "r1-m-p",
      "text": "M brings Moon; Moon in view | sunlight makes its phases new",
      "targetId": "M",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-N",
      "sectionId": "r1-m-p",
      "text": "A clue for N: Neptune. Neptune is the eighth major planet from the Sun and is a cold blue giant world.",
      "targetId": "N",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-O",
      "sectionId": "r1-m-p",
      "text": "past the quiet stars, here comes Observatory for O. It is a place equipped for observing the sky with telescopes or other instruments.",
      "targetId": "O",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-P",
      "sectionId": "r1-m-p",
      "text": "Probe—that is our P. A space probe is an uncrewed spacecraft sent to collect information about space or another world.",
      "targetId": "P",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Q",
      "sectionId": "r1-q-t",
      "text": "Spot Q: Quarter Moon! Quarter Moon tonight | half the sunlit face appears in sight",
      "targetId": "Q",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-R",
      "sectionId": "r1-q-t",
      "text": "R brings Rover; It is a mobile robot or vehicle designed to explore the surface of another world.",
      "targetId": "R",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-S",
      "sectionId": "r1-q-t",
      "text": "A clue for S: Satellite. Satellite goes round | orbit keeps its path Earth-bound",
      "targetId": "S",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-T",
      "sectionId": "r1-q-t",
      "text": "past the quiet stars, here comes Telescope for T. A telescope collects light or other signals to help us study distant objects.",
      "targetId": "T",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-U",
      "sectionId": "r1-u-x",
      "text": "Universe—that is our U. Universe in view | space clue coming through",
      "targetId": "U",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-V",
      "sectionId": "r1-u-x",
      "text": "Spot V: Venus! Venus is a rocky planet covered by a thick atmosphere and very hot surface conditions.",
      "targetId": "V",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-W",
      "sectionId": "r1-u-x",
      "text": "W brings World; World in the frame | planet or moon can carry the name",
      "targetId": "W",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-X",
      "sectionId": "r1-u-x",
      "text": "A clue for X: Xenon Thruster. A xenon thruster uses electrically accelerated xenon ions to produce gentle, efficient thrust.",
      "targetId": "X",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-6-1",
      "sectionId": "chorus-r1-6",
      "text": "Star by star, A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-6-2",
      "sectionId": "chorus-r1-6",
      "text": "Catch the word and orbit with me!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-Y",
      "sectionId": "r1-y-z",
      "text": "past the quiet stars, here comes Yoke for Y. Yoke in hand-control view | steering input is the clue",
      "targetId": "Y",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Z",
      "sectionId": "r1-y-z",
      "text": "Zero-gravity Chair—that is our Z. It is a reclining chair named for a body position that spreads support; it does not create real weightlessness.",
      "targetId": "Z",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r2-A",
      "sectionId": "r2-a-d",
      "text": "Spot A ... Astronaut! Lift one launch-finger, then freeze.",
      "targetId": "A",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-B",
      "sectionId": "r2-a-d",
      "text": "Call B, wait ... Booster! Make a round space-window, then point.",
      "targetId": "B",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-C",
      "sectionId": "r2-a-d",
      "text": "Which word fits C? ... Comet! Trace one orbit, then point.",
      "targetId": "C",
