      "id": "r2-M",
      "sectionId": "r2-m-p",
      "text": "Call M ... Maple! Reach both hands up like branches.",
      "targetId": "M",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
