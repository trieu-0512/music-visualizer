      "text": "N ... N ... Nest! Cup both hands like a nest.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "Ready for O? ... Oak! Reach both hands up like branches.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "Show P ... Pinecone! Cup fingers into a small cone shape.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Q",
      "sectionId": "r2-q-t",
      "text": "Call Q ... Quail! Make tiny pecking finger taps.",
      "targetId": "Q",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-R",
      "sectionId": "r2-q-t",
      "text": "R ... R ... River! Move one hand in a winding path.",
      "targetId": "R",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-S",
      "sectionId": "r2-q-t",
      "text": "Ready for S? ... Squirrel! Make two tiny walking or hopping finger-steps.",
      "targetId": "S",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-T",
      "sectionId": "r2-q-t",
      "text": "Show T ... Trail! Trace the land or ice shape in the air.",
      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Call U ... Underbrush! Grow one hand upward, then sway.",
      "targetId": "U",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "V ... V ... Violet! Open both hands like a flower.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "Ready for W? ... Wolf! Make two quiet paw-steps.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
