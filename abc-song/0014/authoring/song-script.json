    },
    {
      "id": "outro-1",
      "sectionId": "outro",
      "text": "Long shadows cross the field, then fade.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "outro-2",
      "sectionId": "outro",
      "text": "A to Z rests at the end of day.",
      "objective": "narration",
      "objectReveal": "none"
    }
  ]
