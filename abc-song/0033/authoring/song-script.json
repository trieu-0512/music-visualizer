      "id": "chorus-r2-3-1",
      "sectionId": "chorus-r2-3",
      "text": "Rock and bloom—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r2-3-2",
      "sectionId": "chorus-r2-3",
      "text": "Desert plants are fun to see!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r2-M",
      "sectionId": "r2-m-p",
      "text": "Call M ... Mesquite! Reach both hands up like branches.",
      "targetId": "M",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
      "sectionId": "r2-m-p",
      "text": "N ... N ... Nighthawk! Point to the matching picture, then make one small shape gesture.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "Ready for O? ... Oasis! Trace the land or ice shape in the air.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "Show P ... Prickly Pear! Pretend to pick it gently, then show the picture.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Q",
      "sectionId": "r2-q-t",
      "text": "Call Q ... Quail! Make tiny pecking finger taps.",
      "targetId": "Q",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-R",
      "sectionId": "r2-q-t",
      "text": "R ... R ... Rattlesnake! Trace one slow curving path with a finger.",
      "targetId": "R",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-S",
      "sectionId": "r2-q-t",
      "text": "Ready for S? ... Scorpion! Wiggle tiny fingers or make a small flutter.",
      "targetId": "S",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-T",
      "sectionId": "r2-q-t",
      "text": "Show T ... Tumbleweed! Grow one hand upward, then sway.",
      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Call U ... Urial! Tap two quiet hoof-beats with your fingers.",
      "targetId": "U",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "V ... V ... Vulture! Lift two gentle wings, then hold still.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "Ready for W? ... Wadi! Trace the land or ice shape in the air.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
      "sectionId": "r2-u-x",
      "text": "Show X ... Xerophyte! Grow one hand upward, then sway.",
      "targetId": "X",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Y",
      "sectionId": "r2-y-z",
      "text": "Call Y ... Yucca! Grow one hand upward, then sway.",
      "targetId": "Y",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Z",
