      "text": "Show L ... Lavender! Open both hands like a flower.",
      "targetId": "L",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-M",
      "sectionId": "r2-m-p",
      "text": "Care clue M ... Mulch! Point to the matching picture, then make one small shape gesture.",
      "targetId": "M",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
      "sectionId": "r2-m-p",
      "text": "Pause at N ... Nest! Cup both hands like a nest.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "Safe check, O? ... Orchid! Open both hands like a flower.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "Show P ... Pea! Pretend to pick it gently, then show the picture.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "chorus-r2-4-1",
      "sectionId": "chorus-r2-4",
      "text": "Pat, pour, pause—A-B-C!",
      "objective": "verbatim",
