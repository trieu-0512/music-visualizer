      "objectReveal": "target-word"
    },
    {
      "id": "r2-I",
      "sectionId": "r2-i-l",
      "text": "Care clue I ... Iris! Open your hands like a flower.",
      "targetId": "I",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-J",
      "sectionId": "r2-i-l",
      "text": "Pause at J ... Jasmine! Open both hands like a flower.",
      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "Safe check, K? ... Kneeling Pad! Point to the matching picture, then make one small shape gesture.",
      "targetId": "K",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-L",
