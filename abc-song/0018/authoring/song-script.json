    },
    {
      "id": "outro-1",
      "sectionId": "outro",
      "text": "Last drop sinks; the tools and hands grow still.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "outro-2",
      "sectionId": "outro",
      "text": "A to Z leaves a cared-for bed behind.",
      "objective": "narration",
      "objectReveal": "none"
    }
