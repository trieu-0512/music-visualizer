      "text": "Safe check, S? ... Sunflower! Open both hands like a flower.",
      "targetId": "S",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-T",
      "sectionId": "r2-q-t",
      "text": "Show T ... Trowel! Point to the picture and name its job.",
      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Care clue U ... Umbrella! Open both hands into a wide umbrella shape.",
      "targetId": "U",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "Pause at V ... Violet! Open both hands like a flower.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "Safe check, W? ... Worm! Wiggle one finger through imaginary soil.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
      "sectionId": "r2-u-x",
      "text": "Show X ... Xeranthemum! Open both hands like a flower.",
      "targetId": "X",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Y",
      "sectionId": "r2-y-z",
      "text": "Care clue Y ... Yam! Pretend to pick it gently, then show the picture.",
      "targetId": "Y",
      "objective": "retrieval-action",
