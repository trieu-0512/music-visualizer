{
  "version": 1,
  "mappingRevision": 1,
  "lines": [
    {
      "id": "intro-1",
      "sectionId": "intro",
      "text": "Chug-chug, wheel-turn—the gate rolls by.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "intro-2",
      "sectionId": "intro",
      "text": "We won't stand still; each stop has a word.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r1-A",
      "sectionId": "r1-a-d",
      "text": "Engine starts; A is Apron. Cloth across the front | helping work clothes stay cleaner while the route begins.",
      "targetId": "A",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-B",
      "sectionId": "r1-a-d",
      "text": "B — Barn! Wide door, high roof | our rolling route begins beside the shelter.",
      "targetId": "B",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-C",
      "sectionId": "r1-a-d",
      "text": "C? Chicken! Scratch-scratch near the wheel track | feet rake soil while the beak pecks small bits.",
      "targetId": "C",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-D",
      "sectionId": "r1-a-d",
      "text": "D ... D ... Duck! Pond-side paddle | broad bill dips as the tractor rolls past water.",
      "targetId": "D",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-E",
      "sectionId": "r1-e-h",
      "text": "First row, E — Egg. Smooth oval shell | still in the nest while wheels keep turning.",
      "targetId": "E",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-F",
      "sectionId": "r1-e-h",
      "text": "F is Fence. Post, gap, post | a boundary traces the field beside our path.",
      "targetId": "F",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-G",
      "sectionId": "r1-e-h",
      "text": "G? Grain! Tiny seed becomes a load | wheat, oats, or corn ready for the bin.",
      "targetId": "G",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-H",
      "sectionId": "r1-e-h",
      "text": "H — Hen! Soft cluck by the coop | an adult female chicken that can lay eggs.",
      "targetId": "H",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-2-1",
      "sectionId": "chorus-r1-2",
      "text": "Chug, turn, stop—then on we roll!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-2-2",
      "sectionId": "chorus-r1-2",
      "text": "A to Z around the farm we go!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-I",
      "sectionId": "r1-i-l",
      "text": "Next stop, I — Ice Chest. Cool box, lid shut | food and drinks stay chilled during the workday.",
      "targetId": "I",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-J",
      "sectionId": "r1-i-l",
      "text": "J ... J ... Jar! Wide mouth, firm sides | a lidded container carried carefully from shelf to table.",
      "targetId": "J",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-K",
      "sectionId": "r1-i-l",
      "text": "K? Kid Goat! Two quick hoofbeats beside the track | young goat trots, pauses, looks back.",
      "targetId": "K",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-L",
      "sectionId": "r1-i-l",
      "text": "L is Ladder. Rung after rung | adult climbing tool parked safely by the barn.",
      "targetId": "L",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-M",
      "sectionId": "r1-m-p",
      "text": "Halfway round, M — Mule. Steady hooves, strong body | a working animal that can carry or pull.",
      "targetId": "M",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-N",
      "sectionId": "r1-m-p",
      "text": "N ... N ... Nest! Twigs curl into a cup | a bird-built place for eggs and chicks.",
      "targetId": "N",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-O",
      "sectionId": "r1-m-p",
      "text": "O? Orchard! The tractor leaves the yard for rows of fruit or nut trees.",
      "targetId": "O",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-P",
      "sectionId": "r1-m-p",
      "text": "P is Pig. Snout down, soil up | rooting beside the pen as wheels roll on.",
      "targetId": "P",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Q",
      "sectionId": "r1-q-t",
      "text": "Farmhouse stop, Q — Quilt. Stitch after stitch | layered cloth folded warm and thick.",
      "targetId": "Q",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-R",
      "sectionId": "r1-q-t",
      "text": "R ... R ... Rake! Teeth in a row | an adult tool gathers loose material from the ground.",
      "targetId": "R",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-S",
      "sectionId": "r1-q-t",
      "text": "S? Scarecrow! Arms out in the crop row | a still field figure built to discourage birds.",
      "targetId": "S",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-T",
      "sectionId": "r1-q-t",
      "text": "T is Trough. Long open container | feed or water waits where farm animals can reach it.",
      "targetId": "T",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-5-1",
      "sectionId": "chorus-r1-5",
      "text": "Chug, turn, stop—then on we roll!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-5-2",
      "sectionId": "chorus-r1-5",
      "text": "A to Z around the farm we go!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-U",
      "sectionId": "r1-u-x",
      "text": "At the animal yard, U — Udder. Milk-producing organ beneath animals such as cows, goats, and sheep.",
      "targetId": "U",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-V",
      "sectionId": "r1-u-x",
      "text": "V ... V ... Vegetable Basket! Harvest gathered together | one carry from field toward the farm table.",
      "targetId": "V",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-W",
      "sectionId": "r1-u-x",
      "text": "W? Wheat! Tall grain heads ripple beside the track | seeds later ground to make flour.",
      "targetId": "W",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-X",
      "sectionId": "r1-u-x",
      "text": "X is X-ray Vet Image. The route pauses at animal care | an inside view of bones helps the vet check what eyes cannot see.",
      "targetId": "X",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Y",
      "sectionId": "r1-y-z",
      "text": "Near the porch, Y — Yarn. Long spun fiber loops and winds | ready for knitting or weaving.",
      "targetId": "Y",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Z",
      "sectionId": "r1-y-z",
      "text": "Last row, Z — Zucchini! Long green squash under broad leaves | the tractor trail ends where harvest grows.",
      "targetId": "Z",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-7-1",
      "sectionId": "chorus-r1-7",
      "text": "Chug, turn, stop—then on we roll!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-7-2",
      "sectionId": "chorus-r1-7",
      "text": "A to Z around the farm we go!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "interlude-1",
      "sectionId": "mid-interlude",
      "text": "Engine idles for one breath—now call the route stops back.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r2-A",
      "sectionId": "r2-a-d",
      "text": "Tractor stops at A ... Apron! Trace a little apron shape on your shirt.",
      "targetId": "A",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-B",
      "sectionId": "r2-a-d",
      "text": "Roll to B ... Barn! Make a roof shape with both hands.",
      "targetId": "B",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-C",
      "sectionId": "r2-a-d",
      "text": "Ready, C? ... Chicken! Lift two gentle wings, then hold still.",
      "targetId": "C",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-D",
      "sectionId": "r2-a-d",
      "text": "D ... D ... Duck! Paddle both hands gently.",
      "targetId": "D",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-E",
      "sectionId": "r2-e-h",
      "text": "Tractor stops at E ... Egg! Make a small oval with your hands.",
      "targetId": "E",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-F",
      "sectionId": "r2-e-h",
      "text": "Roll to F ... Fence! Hold fingers upright like fence posts.",
      "targetId": "F",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-G",
      "sectionId": "r2-e-h",
      "text": "Ready, G? ... Grain! Pinch two fingers like a tiny grain.",
      "targetId": "G",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-H",
      "sectionId": "r2-e-h",
      "text": "H ... H ... Hen! Lift two gentle wings, then hold still.",
      "targetId": "H",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-I",
      "sectionId": "r2-i-l",
      "text": "Tractor stops at I ... Ice Chest! Point to the matching picture, then make one small shape gesture.",
      "targetId": "I",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-J",
      "sectionId": "r2-i-l",
      "text": "Roll to J ... Jar! Point to the matching picture, then make one small shape gesture.",
      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "Ready, K? ... Kid Goat! Tap two quiet hoof-beats with your fingers.",
      "targetId": "K",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-L",
      "sectionId": "r2-i-l",
      "text": "L ... L ... Ladder! Point to the matching picture, then make one small shape gesture.",
      "targetId": "L",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-M",
      "sectionId": "r2-m-p",
      "text": "Tractor stops at M ... Mule! Tap two quiet hoof-beats with your fingers.",
      "targetId": "M",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
      "sectionId": "r2-m-p",
      "text": "Roll to N ... Nest! Cup both hands like a nest.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "Ready, O? ... Orchard! Point to the matching picture, then make one small shape gesture.",
      "targetId": "O",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "P ... P ... Pig! Tap two quiet hoof-beats with your fingers.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "chorus-r2-4-1",
      "sectionId": "chorus-r2-4",
      "text": "Chug, turn, stop—then on we roll!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r2-4-2",
      "sectionId": "chorus-r2-4",
      "text": "A to Z around the farm we go!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r2-Q",
      "sectionId": "r2-q-t",
      "text": "Tractor stops at Q ... Quilt! Mime pulling a warm quilt up gently.",
      "targetId": "Q",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-R",
      "sectionId": "r2-q-t",
      "text": "Roll to R ... Rake! Point to the picture and name its job.",
      "targetId": "R",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-S",
      "sectionId": "r2-q-t",
      "text": "Ready, S? ... Scarecrow! Stretch arms out like a scarecrow.",
      "targetId": "S",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-T",
      "sectionId": "r2-q-t",
      "text": "T ... T ... Trough! Point to the matching picture, then make one small shape gesture.",
      "targetId": "T",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-U",
      "sectionId": "r2-u-x",
      "text": "Tractor stops at U ... Udder! Point to the matching picture, then make one small shape gesture.",
      "targetId": "U",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-V",
      "sectionId": "r2-u-x",
      "text": "Roll to V ... Vegetable Basket! Point to the matching picture, then make one small shape gesture.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "Ready, W? ... Wheat! Point to the matching picture, then make one small shape gesture.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
      "sectionId": "r2-u-x",
      "text": "X ... X ... X-ray Vet Image! Point to the picture and name its job.",
      "targetId": "X",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Y",
      "sectionId": "r2-y-z",
      "text": "Tractor stops at Y ... Yarn! Point to the matching picture, then make one small shape gesture.",
      "targetId": "Y",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Z",
      "sectionId": "r2-y-z",
      "text": "Roll to Z ... Zucchini! Pretend to pick it gently, then show the picture.",
      "targetId": "Z",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "chorus-r2-7-1",
      "sectionId": "chorus-r2-7",
      "text": "Chug, turn, stop—then on we roll!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r2-7-2",
      "sectionId": "chorus-r2-7",
      "text": "A to Z around the farm we go!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "outro-1",
      "sectionId": "outro",
      "text": "Engine down; dust settles in the track.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "outro-2",
      "sectionId": "outro",
      "text": "A to Z rode out and circled back.",
      "objective": "narration",
      "objectReveal": "none"
    }
  ]
}
