    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "Find W ... Waterfall! Let both hands tumble gently downward.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
