      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-C",
      "sectionId": "r2-a-d",
      "text": "Which lane C? ... Cutting Board! Flatten both palms into a board shape.",
      "targetId": "C",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-D",
      "sectionId": "r2-a-d",
      "text": "Table sort D ... Dish! Trace a shallow plate or bowl circle.",
      "targetId": "D",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-E",
      "sectionId": "r2-e-h",
      "text": "Category E ... Egg! Make one oval shell shape.",
      "targetId": "E",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-F",
      "sectionId": "r2-e-h",
      "text": "Food/tool F ... Fork! Show four finger-tines; keep hands empty.",
