      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-J",
      "sectionId": "r2-i-l",
      "text": "Food/tool J ... Jar! Make a wide jar body and a lid circle.",
      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "Which lane K? ... Knife! Point only; empty-hand mime while an adult handles the real tool.",
      "targetId": "K",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
