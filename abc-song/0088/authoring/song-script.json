      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-G",
      "sectionId": "r2-e-h",
      "text": "Which lane G? ... Grapes! Dot a small bunch of round grapes.",
      "targetId": "G",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-H",
      "sectionId": "r2-e-h",
      "text": "Table sort H ... Hot Pot! Point only; empty-hand mime while an adult handles the real tool.",
