  "lines": [
    {
      "id": "intro-1",
      "sectionId": "intro",
      "text": "Apple is food; bowl is a container; knife is a sharp prep tool.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "intro-2",
      "sectionId": "intro",
      "text": "A meal picture gets clearer when categories stay separate.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r1-A",
      "sectionId": "r1-a-d",
      "text": "A — Apple! Whole fruit with fiber-rich flesh and skin | food lane.",
      "targetId": "A",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-B",
      "sectionId": "r1-a-d",
      "text": "B ... B ... Bowl! Container for serving or combining ingredients | container lane.",
      "targetId": "B",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-C",
      "sectionId": "r1-a-d",
      "text": "C? Cutting Board! Prep surface protects counter and provides stable work area | adult-supervised prep lane.",
      "targetId": "C",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-D",
      "sectionId": "r1-a-d",
      "text": "D is Dish. Can mean tableware or prepared food | context decides the category.",
      "targetId": "D",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-E",
      "sectionId": "r1-e-h",
      "text": "E — Egg! Protein-rich food used in many dishes | raw egg needs hygiene/cooking care.",
      "targetId": "E",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-F",
      "sectionId": "r1-e-h",
      "text": "F ... F ... Fork! Eating utensil with tines | table-tool lane.",
      "targetId": "F",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-G",
      "sectionId": "r1-e-h",
      "text": "G? Grapes! Fruit in bunches | adult preparation reduces choking risk for young children.",
      "targetId": "G",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-H",
      "sectionId": "r1-e-h",
      "text": "H is Hot Pot. Shared hot broth/cooking vessel | heat hazard means observe from safe distance.",
      "targetId": "H",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-2-1",
      "sectionId": "chorus-r1-2",
      "text": "Food, container, tool—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-2-2",
      "sectionId": "chorus-r1-2",
      "text": "Sort the kitchen word before it reaches the table.",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-I",
      "sectionId": "r1-i-l",
      "text": "I — Ice Cream! Frozen dessert | food lane, not everyday nutrition requirement.",
      "targetId": "I",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-J",
      "sectionId": "r1-i-l",
      "text": "J ... J ... Jar! Storage/serving container with wide opening | container lane.",
      "targetId": "J",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-K",
      "sectionId": "r1-i-l",
      "text": "K? Knife! Sharp prep tool | adult-only in this song.",
      "targetId": "K",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-L",
      "sectionId": "r1-i-l",
      "text": "L is Lemon. Citrus fruit with acidic juice | ingredient/food lane.",
      "targetId": "L",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-M",
      "sectionId": "r1-m-p",
      "text": "M — Muffin! Baked food whose ingredients vary | avoid pretending all muffins have identical nutrition.",
      "targetId": "M",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-N",
      "sectionId": "r1-m-p",
      "text": "N ... N ... Noodles! Cooked dough strands/shapes | food lane, recipe varies widely.",
      "targetId": "N",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-O",
      "sectionId": "r1-m-p",
      "text": "O? Orange! Citrus fruit with peel and segments | food lane.",
      "targetId": "O",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-P",
      "sectionId": "r1-m-p",
      "text": "P is Pan. Cooking vessel | hot-tool lane when heated.",
      "targetId": "P",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Q",
      "sectionId": "r1-q-t",
      "text": "Q — Quiche! Savory baked egg-based dish often with dairy/vegetables/meat depending recipe | prepared-food lane.",
      "targetId": "Q",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-R",
      "sectionId": "r1-q-t",
      "text": "R ... R ... Rolling Pin! Dough-shaping tool | prep lane.",
      "targetId": "R",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-S",
      "sectionId": "r1-q-t",
      "text": "S? Spoon! Eating/serving/stirring utensil | table or prep lane depending use.",
      "targetId": "S",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-T",
      "sectionId": "r1-q-t",
      "text": "T is Tongs. Gripping/serving tool | only safe for child use when cool, suitable, and supervised.",
      "targetId": "T",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-5-1",
      "sectionId": "chorus-r1-5",
      "text": "Food, container, tool—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "chorus-r1-5-2",
      "sectionId": "chorus-r1-5",
      "text": "Sort the kitchen word before it reaches the table.",
      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-U",
      "sectionId": "r1-u-x",
      "text": "U — Utensil! Umbrella term for kitchen/eating tools | exact function needs a more specific name.",
      "targetId": "U",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-V",
      "sectionId": "r1-u-x",
      "text": "V ... V ... Vanilla! Flavor ingredient from vanilla orchid pods/extract | ingredient lane.",
      "targetId": "V",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-W",
      "sectionId": "r1-u-x",
      "text": "W? Whisk! Loop tool mixes and incorporates air | prep lane.",
      "targetId": "W",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-X",
      "sectionId": "r1-u-x",
      "text": "X is X-shaped Cookie Cutter. Dough-shape tool | prep lane, with edges checked for safety.",
      "targetId": "X",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Y",
      "sectionId": "r1-y-z",
      "text": "Y — Yogurt! Fermented dairy food or plant-based analog depending product | food lane; label tells ingredients/allergens.",
      "targetId": "Y",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Z",
      "sectionId": "r1-y-z",
      "text": "Z ... Z ... Zucchini! Summer squash with edible flesh/seeds | vegetable food lane.",
      "targetId": "Z",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "chorus-r1-7-1",
      "sectionId": "chorus-r1-7",
      "text": "Food, container, tool—A-B-C!",
      "objective": "verbatim",
      "objectReveal": "none"
    },
