      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-P",
      "sectionId": "r2-m-p",
      "text": "Table sort P ... Pan! Point only; empty-hand mime while an adult handles the real tool.",
      "targetId": "P",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-Q",
      "sectionId": "r2-q-t",
      "text": "Category Q ... Quiche! Trace a round crust edge and wedge shape.",
      "targetId": "Q",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
