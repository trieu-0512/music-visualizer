      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-N",
      "sectionId": "r2-m-p",
      "text": "Food/tool N ... Noodles! Trace three long wavy strands.",
      "targetId": "N",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-O",
      "sectionId": "r2-m-p",
      "text": "Which lane O? ... Orange! Make a round peel; divide imaginary segments.",
