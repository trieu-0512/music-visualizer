    },
    {
      "id": "interlude-1",
      "sectionId": "mid-interlude",
      "text": "The canopy hushes for one beat—now the clues come back.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r2-A",
      "sectionId": "r2-a-d",
      "text": "Spot A ... Anaconda! Trace one slow curving path with a finger.",
