      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "K? ... Kapok Tree! Reach both hands up like branches.",
      "targetId": "K",
      "objective": "retrieval-action",
