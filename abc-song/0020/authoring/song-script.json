    },
    {
      "id": "outro-1",
      "sectionId": "outro",
      "text": "Back at the step, soil dust rests on our shoes.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "outro-2",
      "sectionId": "outro",
      "text": "A to Z made one small backyard feel wide.",
      "objective": "narration",
      "objectReveal": "none"
    }
  ]
