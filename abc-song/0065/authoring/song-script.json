    {
      "id": "r1-Y",
      "sectionId": "r1-y-z",
      "text": "under the garden leaves, Y meets Yellow Butterfly. Yellow Butterfly small in sight | legs, wings, or body make the clue feel right",
      "targetId": "Y",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Z",
      "sectionId": "r1-y-z",
      "text": "Z—Zebra Longwing! It is a butterfly: scaled wings wide, curled proboscis tucked inside.",
      "targetId": "Z",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "interlude-1",
      "sectionId": "mid-interlude",
      "text": "The garden goes still under one leaf. Tiny clues return after the hush.",
      "objective": "narration",
      "objectReveal": "none"
    },
    {
      "id": "r2-A",
      "sectionId": "r2-a-d",
      "text": "A ... Ant! Flutter or crawl once, then freeze.",
