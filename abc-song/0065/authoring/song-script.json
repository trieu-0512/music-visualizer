      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-X",
      "sectionId": "r1-u-x",
      "text": "What does X reveal? Xylophone Beetle! Xylophone Beetle is a beetle; hard front wings cover softer flight wings.",
      "targetId": "X",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
