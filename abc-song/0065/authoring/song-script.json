    {
      "id": "r1-U",
      "sectionId": "r1-u-x",
      "text": "U—Ulysses Butterfly! Ulysses Butterfly down low | tiny body clues help the name to show",
      "targetId": "U",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-V",
      "sectionId": "r1-u-x",
      "text": "V ... V ... Vinegar Fly. Vinegar Fly is a small fly with six legs, antennae, and one wing pair.",
