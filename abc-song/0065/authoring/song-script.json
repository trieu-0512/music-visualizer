      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-W",
      "sectionId": "r1-u-x",
      "text": "Weevil steps in for W. It is a beetle; hard front wings cover softer flight wings.",
