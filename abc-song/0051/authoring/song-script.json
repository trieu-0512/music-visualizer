      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "K? ... Krypton Tank! Lift one launch-finger, then freeze.",
      "targetId": "K",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
