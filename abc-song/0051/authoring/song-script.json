      "text": "I ... International Space Station! Make a round space-window, then point.",
      "targetId": "I",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-J",
      "sectionId": "r2-i-l",
      "text": "Remember J ... Jet Pack! Make a round space-window, then point.",
      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
