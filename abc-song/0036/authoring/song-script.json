      "text": "V? ... Velvet Scoter! Lift two gentle wings, then hold still.",
      "targetId": "V",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-W",
      "sectionId": "r2-u-x",
      "text": "Find W ... Walrus! Glide one hand gently like a swimmer.",
      "targetId": "W",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-X",
      "sectionId": "r2-u-x",
      "text": "X ... X ... Xylophone! Tap two fingers in the air like gentle xylophone mallets.",
      "targetId": "X",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
