      "targetId": "J",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-K",
      "sectionId": "r2-i-l",
      "text": "Find K ... Knot! Twist two fingers together like a wood knot.",
      "targetId": "K",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-L",
      "sectionId": "r2-i-l",
      "text": "L ... L ... Log! Hold one forearm straight like a log.",
      "targetId": "L",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
