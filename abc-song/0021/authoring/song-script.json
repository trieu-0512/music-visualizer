      "targetId": "F",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-G",
      "sectionId": "r2-e-h",
      "text": "Find G ... Grouse! Point to the matching picture, then make one small shape gesture.",
      "targetId": "G",
