      "objectReveal": "target-word"
    },
    {
      "id": "r2-H",
      "sectionId": "r2-e-h",
      "text": "H ... H ... Hedgehog! Make two tiny walking or hopping finger-steps.",
      "targetId": "H",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-I",
      "sectionId": "r2-i-l",
      "text": "I ... Ivy! Grow one hand upward, then sway.",
      "targetId": "I",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-J",
