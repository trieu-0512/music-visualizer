      "objective": "verbatim",
      "objectReveal": "none"
    },
    {
      "id": "r1-Y",
      "sectionId": "r1-y-z",
      "text": "What did Y find? Yellow Scorpion! It is a pale desert scorpion; we only observe it from a safe distance.",
      "targetId": "Y",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r1-Z",
      "sectionId": "r1-y-z",
      "text": "Look at Z: Ziziphus Shrub! It is a hardy thorny plant that can bear small round fruits.",
      "targetId": "Z",
      "objective": "lexical-semantic",
      "objectReveal": "line-start"
    },
    {
      "id": "r2-A",
      "sectionId": "r2-a-d",
      "text": "Look for A ... Armadillo! Trace one slow curving path with a finger.",
      "targetId": "A",
      "objective": "retrieval-action",
      "objectReveal": "target-word"
    },
    {
      "id": "r2-B",
      "sectionId": "r2-a-d",
