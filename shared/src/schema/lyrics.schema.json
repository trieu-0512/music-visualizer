{
  "title": "LyricsJson",
  "description": "Standardized timed lyric artifact consumed by preview/render.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "lines"],
  "properties": {
    "version": { "const": 1 },
    "source": {
      "type": "string",
      "enum": ["transcriber", "original+transcriber"]
    },
    "lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/lyricLine" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioSha256"],
      "properties": {
        "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mappingRevision": { "type": "integer", "minimum": 1 },
        "songScriptMappingRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "canonicalLineCount", "segmentCount"],
      "properties": {
        "mode": { "enum": ["asr-only", "canonical-order"] },
        "status": { "enum": ["clean", "review-required"] },
        "canonicalLineCount": { "type": "integer", "minimum": 0 },
        "segmentCount": { "type": "integer", "minimum": 0 },
        "averageTextSimilarity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "wordTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "text": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 }
      }
    },
    "lyricLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "text", "line1", "line2"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "text": { "type": "string" },
        "line1": { "type": "string" },
        "line2": { "type": "string" },
        "words": {
          "type": "array",
          "items": { "$ref": "#/$defs/wordTiming" }
        },
        "id": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "pattern": "^[A-Z]$" },
        "objective": {
          "enum": ["narration", "lexical-semantic", "verbatim", "retrieval-action", "phonics"]
        },
        "letter": { "type": "string", "pattern": "^[A-Z]$" },
        "object": { "type": "string", "minLength": 1 },
        "objectRevealAt": { "type": "number", "minimum": 0 },
        "alignmentConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
