    "rms": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "bass": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "bandCount": { "type": "integer", "minimum": 0 },
    "beats": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    }
  }
}
