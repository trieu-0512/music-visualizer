{
  "title": "SongScriptJson",
  "description": "Machine-readable authoring script derived from a locked mapping. It gives each sung/display line a stable id, learning objective, optional A-Z target id, and visual reveal policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mappingRevision", "lines"],
  "properties": {
    "version": { "const": 1 },
    "mappingRevision": { "type": "integer", "minimum": 1 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line" }
    }
  },
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "objective"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "sectionId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "pattern": "^[A-Z]$" },
        "objective": {
          "enum": ["narration", "lexical-semantic", "verbatim", "retrieval-action", "phonics"]
        },
        "objectReveal": {
          "enum": ["line-start", "target-word", "line-end", "none"]
        }
      }
    }
  }
}
